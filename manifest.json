{
  "manifest_version": 3,
  "name": "包托办V21·指纹备货中枢Pro",
  "version": "21.0.48",
  "description": "包托办V21·指纹备货中枢Pro · V21.0.48(液态玻璃·19区迁移)· 包托办科技出品",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "tabs",
    "webNavigation",
    "alarms",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "V21 · Apple工业"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/btb-16.png",
    "48": "icons/btb-48.png",
    "128": "icons/btb-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.dgjapp.com/*"
      ],
      "js": [
        "dgj-api-capture.js",
        "dgj-image-fetcher.js",
        "dgj-api-probe.js"
      ],
      "run_at": "document_idle"
    }
  ]
}